%% tcolorboxes
%% Examples: https://www.overleaf.com/project/6ac79b02f0f8ed56bc71e688

\definecolor{TitleColor}{HTML}{0d0d0d}
\definecolor{Dark}{HTML}{9893a5}
\newtcolorbox{theorem-block}[1][]{
    enhanced,
    title={\textcolor{TitleColor}{#1}},
    colbacktitle=Gray1,
    colframe=white,
    boxrule=0pt,
    borderline west={2pt}{0pt}{Gray2},
    arc=0pt,
    left=18pt,
    right=12pt,
    top=10pt,
    bottom=10pt,
    width=\linewidth, 
}


