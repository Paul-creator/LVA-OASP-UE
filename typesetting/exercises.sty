%% Math

% with the unicode-math package
\renewcommand{\vec}[1]{\symbf{#1}}
\newcommand{\aug}[1]{\underline{\vec{#1}}}
\newcommand{\mat}[1]{\symbf{#1}}
\newcommand{\E}[1]{\mathrm{E}\left\{#1\right\}}
\newcommand{\Var}[1]{\mathrm{Var}\left\{#1\right\}}
\newcommand{\Cov}[2]{\mathrm{Cov}\left\{#1,#2\right\}}
\newcommand{\Corr}[2]{\mathrm{Corr}\left\{#1,#2\right\}}
\newcommand{\abs}[1]{\left|#1\right|}
\newcommand{\norm}[2][2]{\lVert#2\rVert_{#1}}
\newcommand{\D}{\mathrm{d}}
\renewcommand{\Re}[1]{\mathrm{Re}\left\{#1\right\}}
\renewcommand{\Im}[1]{\mathrm{Im}\left\{#1\right\}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}
\newcommand{\I}{\mathbf{I}}
\newcommand{\DefinedBy}{\triangleq}
\newcommand{\ppart}[2][]{\frac{ \partial #1}{ \partial #2}}
\newcommand{\expj}[2][]{e^{#1\jmath #2}}

\newcommand{\ForRange}[2]{\For{#1 \textbf{to} #2}}

