%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Math

% with the unicode-math package
\renewcommand{\vec}[1]{% Vectors
    \symbf{#1}
}
\newcommand{\mat}[1]{% Matrices
    \symbf{#1}%
}
\newcommand{\E}[1]{% Expected Value Operator
    \mathbb{E}\left[#1\right]%
}
\newcommand{\Var}[1]{% Variance 
    \mathrm{Var}\left[#1\right]%
}
\newcommand{\Cov}[2]{% Covariance
    \mathrm{Cov}\left[#1,#2\right]%
}
\newcommand{\Corr}[2]{% Correlation
    \mathrm{Corr}\left[#1,#2\right]%
}
\newcommand{\abs}[1]{% Absolute Value
    \left|#1\right|%
}
\newcommand{\norm}[2][2]{% Norm
    \lVert#2\rVert_{#1}
}
\newcommand{\D}{ % "Differential" upright d. Use in Integrals and the ordinary derivative
    \mathrm{d}
} 
\renewcommand{\Re}[1]{% Real Part of a complex variable
    \mathrm{Re}\left[#1\right]%
}
\renewcommand{\Im}[1]{% Imaginary Part of a complex variable
    \mathrm{Im}\left[#1\right]%
}
\newcommand{\R}{% Set of Real Numbers
    \mathbb{R}%
}
\newcommand{\C}{% Set of Complex Numbers
    \mathbb{C}%
}
\newcommand{\I}{% Identity Matrix
    \mat{I}%
} 
\newcommand{\DefinedBy}{% Use when declaring definitions 
    \triangleq%
}
\newcommand{\pd}[2][]{% Partial Derivative Operator. Mandatory Parameter: differentiation variable. Optional parameter: Value in the numerator.
    \frac{\partial #1}{\partial #2}
}
\newcommand{\pnd}[3][]{% nth order Partial Derivative Operator. 
    \frac{ \partial^{#2} #1}{ \partial #3^2 }%
} 
\newcommand{\expj}[2][]{% Complex Exponential. The Optional parameter may be used to place a - sign before the imaginary j 
    e^{#1\jmath #2}
}                 
\newcommand{\T}{% Transpose T
    \mathsf{T}%
}
\renewcommand{\exp}[1]{%
    \operatorname{exp}\left[#1\right]%
}

